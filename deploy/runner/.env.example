# The runner on its own machine (docs/self-hosting/runner-security.md).

# The instance's public address and its anon (publishable) key; the key only gets requests past the gateway
SUPABASE_URL=https://bogey.example.org
SUPABASE_ANON_KEY=
# From `bogey runner add <name>` on the instance (docker compose exec web bogey runner add judge-1)
BOGEY_RUNNER_KEY=
# A name for this runner; containers it leaves behind are cleaned up under it
BOGEY_RUNNER_ID=judge-1
BOGEY_RUNNER_CONCURRENCY=2

# The runner image; pin a version
BOGEY_RUNNER_IMAGE=ghcr.io/0xethen/bogey-runner:latest
# The uid the runner runs as; it must own the work folder (sudo install -d -o 1000 -g 1000 -m 700 /var/lib/bogey-runner)
BOGEY_RUNNER_UID=1000
BOGEY_RUNNER_WORK_DIR=/var/lib/bogey-runner
# The Docker socket's group (stat -c %g /var/run/docker.sock), and the socket (a rootless daemon's: /run/user/<uid>/docker.sock)
DOCKER_GID=999
BOGEY_RUNNER_DOCKER_SOCKET=/var/run/docker.sock
# runsc to run every sandbox under gVisor; the proxy then refuses any other
BOGEY_RUNNER_RUNTIME=
