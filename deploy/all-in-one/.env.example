# DO NOT REMOVE! Comments are used by the CLI to show help text. DO NOT REMOVE!
# Written by `bogey setup --all-in-one`, which fills in everything left empty below. Re-running it keeps
# the secrets you have; changing POSTGRES_PASSWORD or JWT_SECRET on a database that exists breaks it.

# Where Bogey is served: the main host, and every host (comma-separated). Needs DNS pointing here.
BOGEY_HOST=
BOGEY_HOSTS=
# https://<BOGEY_HOST>, or http:// with --http for a trial that has no certificate
BOGEY_URL=
# The addresses Caddy answers on (BOGEY_HOSTS, each with http:// when --http)
CADDY_SITES=

# Caddyfile (one organization on your hosts) or Caddyfile.hosted (many, certificates on first visit)
CADDYFILE=Caddyfile

# The Bogey image: ghcr.io/0xethen/bogey:<version>, or one you built (docker build -t bogey .)
BOGEY_IMAGE=ghcr.io/0xethen/bogey:latest

# Studio's port on this machine, with `docker compose --profile studio up -d`
STUDIO_PORT=54323

# The challenges runner, with `docker compose -f compose.yml -f compose.runner.yml up -d`
# (docs/self-hosting/runner-security.md). Its key: docker compose exec web bogey runner add runner
BOGEY_RUNNER_KEY=
BOGEY_RUNNER_IMAGE=ghcr.io/0xethen/bogey-runner:latest
# The runner's uid, which must own the work folder (sudo install -d -o 1000 -g 1000 -m 700 /var/lib/bogey-runner)
BOGEY_RUNNER_UID=1000
BOGEY_RUNNER_WORK_DIR=/var/lib/bogey-runner
# The Docker socket's group (stat -c %g /var/run/docker.sock); only docker-proxy gets the socket
DOCKER_GID=999
# runsc runs every sandbox under gVisor, and the proxy refuses any other runtime
BOGEY_RUNNER_RUNTIME=

# Generated secrets. Keep this file private.
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
PG_META_CRYPTO_KEY=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
SEND_EMAIL_HOOK_SECRET=

# What Bogey reads: the public address, the anon key, the service key and the database.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# What the auth service reads
SITE_URL=
SUPABASE_PUBLIC_URL=
API_EXTERNAL_URL=
ADDITIONAL_REDIRECT_URLS=
JWT_EXPIRY=3600

# Email (docs/self-hosting/email.md): sign-in codes and Bogey's own mail go out over this SMTP server.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Sign-in providers (docs/self-hosting/auth.md). Each needs its client ID and secret from the provider;
# the redirect address to give it is API_EXTERNAL_URL/callback.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_SECRET=
AZURE_ENABLED=false
AZURE_CLIENT_ID=
AZURE_SECRET=
AZURE_URL=
GITLAB_ENABLED=false
GITLAB_CLIENT_ID=
GITLAB_SECRET=
GITLAB_URL=
DISCORD_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_SECRET=
KEYCLOAK_ENABLED=false
KEYCLOAK_CLIENT_ID=
KEYCLOAK_SECRET=
KEYCLOAK_URL=
# SAML single sign-on: SAML_ENABLED=true and a private key (docs/self-hosting/auth.md)
SAML_ENABLED=false
SAML_PRIVATE_KEY=
