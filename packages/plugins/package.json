{
  "name": "@bogey/plugins",
  "version": "0.0.0",
  "private": true,
  "description": "Bogey's plugin API and the plugins that ship with it. A plugin owns its manifest, its routes and its UI; the web app only mounts them.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api.ts",
    "./types": "./src/types.ts",
    "./registry": "./src/registry.ts",
    "./nav": "./src/nav.tsx",
    "./updates": "./src/updates.ts",
    "./releases": "./src/releases.ts",
    "./library": "./src/library.ts",
    "./update-check": "./src/update-check.ts",
    "./preferences": "./src/preferences.tsx",
    "./messages": "./src/messages.ts",
    "./errors": "./src/errors.ts",
    "./verbose": "./src/verbose.ts",
    "./runtime": "./src/runtime.tsx",
    "./signals": "./src/signals.ts"
  },
  "scripts": {
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@bogey/config": "workspace:*",
    "@bogey/db": "workspace:*",
    "@bogey/ui": "workspace:*",
    "@bogey/utils": "workspace:*",
    "@tabler/icons-react": "catalog:",
    "fflate": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "react": "catalog:"
  }
}
