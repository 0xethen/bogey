{
  "extends": "../../tsconfig.base.json",
  "include": ["src", "tests", "examples", "bundled/*/**/*", "installed/*/**/*"],
  "exclude": ["node_modules", "dist", "installed/node_modules"],
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node", "vite/client"]
  }
}
