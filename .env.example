# DO NOT REMOVE! Comments are used by the CLI to show help text. DO NOT REMOVE!

# Anything prefixed PUBLIC_ is compiled into the browser bundle, so never put a secret
# behind it. PUBLIC_ is an alias for VITE_ (both are exposed); we recommend PUBLIC_
# because it says what it does.

# Read at runtime by the server, which hands the URL and publishable
# key to the browser, so one build works for any deployment.
SUPABASE_URL=http://localhost:8000
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Server-only. Required by @bogey/db/admin and the CLI.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CLI-only, optional. The Postgres connection string (it has the database password)
# for bogey db, plugins migrate, backup, upgrade, repair and reset. --db-url overrides it.
DATABASE_URL=

# 1 when a proxy that overwrites X-Forwarded-For (like deploy/compose.yml's Caddy) fronts the app.
# Same as network.trustProxy in bogey.config.ts, which is where the other network settings live.
BOGEY_TRUST_PROXY=

# Email (see docs/self-hosting/email.md). Server-only.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
SEND_EMAIL_HOOK_SECRET=v1,whsec_replace-with-a-random-base64-secret # generated with bogey setup. MAKE SURE TO GIVE GOTRUE THIS SAME VALUE (docs/self-hosting/email.md)!
